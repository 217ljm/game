    },
    "instructionDays": {
      "id": "P05",
      "description": "全日制每学年190个教学日、半日制或简易班165个教学日，是缺少逐年全国数据时的游戏时间尺度。",
      "fullDay": 190,
      "halfDayOrSimple": 165
    },
    "householdLaborTime": {
      "id": "P06",
      "description": "学生家庭劳动小时由城乡、家庭行业、食品需要未满足月份和玩家行动共同生成。",
      "baseHoursPerWeek": { "urban": 4, "rural": 8 }
    },
    "studentIllnessAbsence": {
      "id": "P07",
      "description": "学龄儿童常见症状事件和病假日数为首版年龄段代理，不生成未经校准的具体诊断。",
      "meanEpisodesPerYear": 0.65,
      "severeEpisodeProbability": 0.055
    },
    "learningProgress": {
      "id": "P08",
      "description": "0至100学习进展分仅为游戏内部尺度，由出勤、校外练习、既有能力、家庭劳动和随机冲击计算，不冒充统一考试分数。",
      "annualShockStandardDeviation": 8
    },
    "gradeProgression": {
      "id": "P09",
      "description": "留级概率由出勤和学习进展分生成；全国缺少同口径逐年留级数据。",
      "baseRepeatProbability": 0.025
    },
    "individualDropoutProbability": {
      "id": "P10",
      "description": "用年度巩固/辍学锚点为基线，再按家庭实际收入、缺课、家庭劳动和学习进展调整。"
    },
    "graduationProbability": {
      "id": "P11",
      "description": "毕业年以1987届毕业率为锚点，按出勤和学习进展调整。"
    },
    "juniorTransitionProbability": {
      "id": "P12",
      "description": "小学毕业后升入初中的概率以当年全国升学率为基线，按毕业年学习进展、准备投入、家庭收入和随机结果调整。"
    },
    "householdIncomeContinuation": {
      "id": "P13",
      "description": "延续6岁末家庭相对同年同城乡收入位置，每年叠加均值为1的随机冲击。",
      "annualShockSigma": { "urban": 0.13, "rural": 0.19 }
    },
    "visibleStatEvolution": {
      "id": "P14",
      "description": "财富由当年相对收入重算；能力、健康、心情和人际只因已记录的学习、健康、劳动和选择事实变化。"
    },
    "noReentryAfterPrimaryExit": {
      "id": "P15",
      "description": "首版小学阶段在正式退出后不模拟复学；该限制在结局中明确记录。"
    }
