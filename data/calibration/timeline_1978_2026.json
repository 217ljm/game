    {
      "id": "education_and_livelihood_transition_1985_1991",
      "startYear": 1985,
      "endYear": 1991,
      "label": "教育制度与城乡生活继续调整",
      "description": "义务教育进入法律实施阶段，家庭能否持续入学仍要结合所在地和实际收支结算。",
      "sourceIds": ["moe_compulsory_education_funding", "nbs_reform_30_overview"]
    },
    {
      "id": "employment_forms_expand_1992_1997",
      "startYear": 1992,
      "endYear": 1997,
      "label": "就业形式和流动机会增多",
      "description": "职业选择逐渐增多，但具体机会仍受城乡、教育、技能和家庭处境共同影响。",
      "sourceIds": ["nbs_employment_40"]
    },
    {
      "id": "restructuring_housing_education_1998_2001",
      "startYear": 1998,
      "endYear": 2001,
      "label": "就业、住房、升学与开放节点密集出现",
      "description": "城镇单位就业调整、住房制度改革、高等教育扩招和加入世界贸易组织先后影响个人选择环境。",
      "sourceIds": ["nbs_employment_40", "state_council_housing_1998", "moe_education_1999", "mofcom_wto_20_years"]
    },
    {
      "id": "urbanization_and_service_growth_2002_2007",
      "startYear": 2002,
      "endYear": 2007,
      "label": "城镇化和服务业就业继续发展",
      "description": "更多工作与生活机会进入城镇和第三产业，迁移成本与家庭联系仍需逐年权衡。",
      "sourceIds": ["nbs_employment_40", "nbs_reform_30_overview"]
    },
    {
      "id": "labor_contract_stage_2008_2012",
      "startYear": 2008,
      "endYear": 2012,
      "label": "劳动合同制度进入新阶段",
      "description": "合同与劳动保护的制度环境发生变化，个人是否签约、工时和收入仍按具体岗位记录。",
      "sourceIds": ["npc_labor_contract_2008", "nbs_employment_40"]
    },
    {
      "id": "service_and_urban_life_2013_2019",
      "startYear": 2013,
      "endYear": 2019,
      "label": "服务业和城镇生活进一步扩展",
      "description": "第三产业就业与城镇人口占比继续提高，家庭的职业、住房和消费路径更加分化。",
      "sourceIds": ["nbs_employment_40", "nbs_urbanization_14th_five_year", "nbs_living_40"]
    },
    {
      "id": "recent_structure_change_2020_2022",
      "startYear": 2020,
      "endYear": 2022,
      "label": "近期就业和生活结构变化",
      "description": "城镇化和服务业结构继续变化；具体岗位受到的冲击只在对应工作事实上结算。",
      "sourceIds": ["nbs_urbanization_14th_five_year", "nbs_employment_40"]
