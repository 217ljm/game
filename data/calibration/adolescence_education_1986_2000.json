  "assumptions": {
    "householdIncomeContinuation": {
      "id": "A01",
      "description": "延续小学末家庭相对同年同城乡收入位置，每年叠加均值为1的随机冲击；成员职业转换暂未在本阶段重建。",
      "annualShockSigma": { "urban": 0.14, "rural": 0.20 }
    },
    "schoolFormDistribution": {
      "id": "A02",
      "description": "缺少全国逐年城乡初中办学形态份额，以下为可替换代理；具体学校生师比保持空值。",
      "urban": { "district_public_junior": 0.66, "work_unit_affiliated_junior": 0.18, "nine_year_school_junior_section": 0.16 },
      "rural1990": { "township_junior": 0.68, "county_junior": 0.16, "nine_year_school_junior_section": 0.16 },
      "rural2000": { "township_junior": 0.61, "county_junior": 0.25, "nine_year_school_junior_section": 0.14 }
    },
    "instructionAndExpense": {
      "id": "A03",
      "description": "每学年200个教学日及教育现金支出占同年城乡人均收入的比例为首版时间和现金尺度。",
      "instructionDays": 200,
      "baseExpenseShareOfReferenceIncome": { "urban": 0.090, "rural": 0.125 },
      "schoolFormExpenseMultiplier": { "district_public_junior": 1.00, "work_unit_affiliated_junior": 0.88, "nine_year_school_junior_section": 0.92, "township_junior": 1.00, "county_junior": 1.28 }
    },
    "studentIllnessAbsence": {
      "id": "A04",
      "description": "青少年症状事件、病假和较重症状概率为首版代理，不生成未经证实的医学诊断。",
      "meanEpisodesPerYear": 0.52,
      "severeEpisodeProbability": 0.045
    },
    "learningProgress": {
      "id": "A05",
      "description": "0至100学习进展值由出勤、练习、既有能力、家庭劳动、同伴时间与随机冲击生成，不冒充统考或中考成绩。",
      "annualShockStandardDeviation": 9
    },
    "individualDropoutProbability": {
      "id": "A06",
      "description": "以当年全国初中辍学率为基线，再按教育支出占家庭收入、家庭劳动、缺课和学习进展调整。"
    },
    "gradeProgressionAndGraduation": {
      "id": "A07",
      "description": "初中按三年制推进；留级和毕业概率由出勤、学习进展生成，缺少同口径全国逐年数据。",
      "years": 3,
      "baseRepeatProbability": 0.018,
      "baseGraduationProbability": 0.955
    },
    "seniorTransitionProbability": {
      "id": "A08",
      "description": "以初中毕业生升入高中阶段的全国比例为基线，按学习进展、方向准备、教育支出压力和家庭收入生成个体结果。"
    },
    "seniorTrackAllocation": {
      "id": "A09",
      "description": "高中阶段职业教育在校生占比被用作新入学方向的近似锚点，再由学术和职业准备小时调整；两种统计口径并不完全相同。"
    },
    "visibleStatEvolution": {
      "id": "A10",
      "description": "财富由当年家庭人均收入与教育现金支出重算，其他属性只因已记录的健康、学习、劳动、同伴和决定事实变化。"
    },
    "under16NonStudentActivity": {
      "id": "A11",
      "description": "未满16岁的非在校人物只模拟家庭生产、家务、自学和技能观察，不生成用人单位、工资或劳动合同。1991年规定曾为尚不具备初中义务教育条件的农村贫困地区13至15岁少年保留受省级办法严格限制的辅助劳动例外；因没有省份、贫困地区认定和地方办法数据，首版不生成该例外并明确记录。",
      "baseHouseholdHoursPerWeek": { "urban": 15, "rural": 25 },
      "baseSelfStudyHoursPerWeek": { "urban": 5, "rural": 3 }
    },
    "age16PreparationOutcome": {
      "id": "A12",
      "description": "16岁时只生成下一阶段方向、训练小时、求职准备和可接触行业参考，不在本阶段宣称已经获得工作。"
    },
    "parentEmploymentContinuity": {
      "id": "A13",
      "description": "父母和其他家庭成员在本阶段沿用上一阶段职业实体，只更新年龄、劳动月份和收入贡献；转业、下岗和退休由后续家庭职业模块统一实现。"
    },
    "noJuniorReentry": {
      "id": "A14",
      "description": "首版对没有进入初中或提前退出初中的人物暂不模拟复学；可通过自学与训练积累能力，缺口在结局中保留。"
    }
  }
}
