  "assumptions": {
    "householdIncomeContinuation": {
      "id": "YWE01",
      "description": "原家庭成员总收入继续围绕同年同城乡居民人均收入变化；玩家收入另列后再相加。",
      "annualShockSigma": { "urban": 0.17, "rural": 0.22 }
    },
    "parentEmploymentContinuity": {
      "id": "YWE02",
      "description": "本阶段不重建父母完整职业变动，仅继续其既有就业并在家庭收入中分配贡献。"
    },
    "seniorSchoolModel": {
      "id": "YWE03",
      "description": "普通高中和中职均按常见三学年制模拟，学校具体地点、招生线和专业名称未知。",
      "prescribedYears": 3,
      "instructionDays": 200,
      "academicBaseStudyHoursPerWeek": 15,
      "vocationalClassHoursPerWeek": 20,
      "vocationalPracticeHoursPerWeek": 10
    },
    "educationExpense": {
      "id": "YWE04",
      "description": "缺少逐年城乡同口径学费数据时，以居民人均收入比例构造可追溯的现金支出，不声称为实际收费标准。",
      "shareOfReferenceIncome": {
        "academic_senior": { "urban": 0.24, "rural": 0.31 },
        "vocational_secondary": { "urban": 0.27, "rural": 0.34 }
      }
    },
    "seniorLearningAndCompletion": {
      "id": "YWE05",
      "description": "出勤、学习时间、家庭劳动、健康与既有能力共同决定游戏内学习进度、辍学、留级和毕业；不是重建地区考试分数。",
      "annualShockStandardDeviation": 9,
      "academicAnnualExitBase": 0.025,
      "vocationalAnnualExitBase": 0.035,
      "baseRepeatProbability": 0.035,
      "academicFinalGraduationProbability": 0.93,
      "vocationalFinalGraduationProbability": 0.90
    },
    "higherEducationTransition": {
      "id": "YWE06",
      "description": "把全国普通高中毕业生升入普通高校比例作为同届基准，再根据个人学习进度、备考投入和家庭支出负担作个体化；不生成院校或专业。"
    },
    "vocationalSchoolTypeAllocation": {
      "id": "YWE07",
      "description": "以1999和2006年中职招生类型构成为锚插值；成人中专仅保留较小适龄权重，具体专业由训练方向假设生成。"
    },
    "trainingProgram": {
      "id": "YWE08",
      "description": "短训和中职技能方向、训练小时、完成概率为游戏设计假设，均保存为事实。",
      "shortProgramHours": 360,
      "shortProgramMonths": 6,
      "baseCompletionProbability": 0.86
    },
    "opportunityGeneration": {
      "id": "YWE09",
      "description": "候选工作的可见集合来自配置模板，并用全国三次产业就业结构、城乡、学历、技能和家庭介绍调整权重；不把全国结构当成个人分配结果。",
      "candidateCount": 3,
      "maximumSearchAge": 24
    },
    "offerAndHiring": {
      "id": "YWE10",
      "description": "录用概率、合同概率、工时区间和收入相对参照倍数缺少全国同口径微观数据，全部作为显式假设；真实结果由种子结算。",
      "baseHiringProbability": 0.64,
      "familyIntroductionLogOddsBonus": 0.38,
      "vocationalMatchLogOddsBonus": 0.42,
      "seniorEducationLogOddsBonus": 0.18
    },
    "familyEconomicActivity": {
      "id": "YWE11",
      "description": "家庭经济活动按家庭既有主业和城乡生成，个人净收入贡献以城乡居民人均收入折算，不伪造用人单位工资。",
      "incomeReferenceMultipliers": { "urban": 0.72, "rural": 0.62 }
    },
    "healthEpisodes": {
      "id": "YWE12",
      "description": "每年一般症状及少量较重症状按泊松过程生成，只记录天数，不伪造诊断。",
      "meanEpisodesPerYear": 1.35,
      "severeEpisodeProbability": 0.055
    },
    "visibleStatEvolution": {
      "id": "YWE13",
      "description": "健康、财富、心情、能力和关系只由已记录事实改变；财富由家庭总账相对同年城乡参考重算。"
    },
    "eventChoices": {
      "id": "YWE14",
      "description": "高中、中职、训练和求职中的选择权重仅用于自动模拟，玩家选择时不限制。"
    },
    "selfStudyBridge": {
      "id": "YWE15",
      "description": "选择继续自学者先经历一个可记录的自学年，随后进入具体求职机会；本阶段不把自学写成学历。"
    }
  }
