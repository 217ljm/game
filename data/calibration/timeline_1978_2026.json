      "id": "early_reform_1978_1984",
      "startYear": 1978,
      "endYear": 1984,
      "label": "改革开放初期",
      "description": "家庭生产和就业结构开始变化，城乡生活仍有明显差异。",
      "sourceIds": ["nbs_reform_30_overview", "nbs_employment_40", "nbs_living_40"]
