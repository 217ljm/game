  "assumptions": {
    "entryAgeDistribution": {
      "id": "P01",
      "description": "1986年前首轮入学年龄为7岁；1986年后部分儿童6岁入学，其余7岁，城乡比例为可替换代理。",
      "age6EntryShareByResidence": { "urban": 0.38, "rural": 0.18 }
    },
    "individualEnrollmentProbability": {
      "id": "P02",
      "description": "以全国净入学率为基线，按实际人均收入、食品需要未满足月份、健康、入学准备小时和延迟年龄调整。",
      "lateEntryAnnualProbability": 0.72
    },
    "schoolSystemDistribution": {
      "id": "P03",
      "description": "五年制和六年制并存，但缺少全国逐年城乡份额；使用按入学年份和城乡变化的六年制概率代理。",
      "sixYearProbability": {
        "1984": { "urban": 0.52, "rural": 0.22 },
        "1990": { "urban": 0.78, "rural": 0.48 },
        "1995": { "urban": 0.88, "rural": 0.65 }
      }
    },
    "schoolFormDistribution": {
      "id": "P04",
      "description": "城镇地方或单位小学、农村村办或乡镇全日制小学及半日制/简易教学班的份额为首版代理。",
      "urban": { "local_public_full_day": 0.68, "work_unit_full_day": 0.32 },
