{
  "name": "people-life",
  "private": true,
  "version": "0.1.0",
  "description": "中文竖屏季度回合制人生模拟游戏",
  "type": "module",
  "scripts": {
    "birth:sample": "node scripts/simulate-births.mjs --count 1 --seed demo",
    "birth:batch": "node scripts/simulate-births.mjs --count 10000 --seed batch",
    "birth:check": "node scripts/check-birth-generator.mjs",
    "foundation:check": "node scripts/check-character-resources.mjs",
    "process:check": "node scripts/check-life-activity-process.mjs",
    "map:check": "node scripts/check-world-map-presenter.mjs",
    "events:check": "node scripts/check-combination-events.mjs",
    "variety:check": "node scripts/check-content-variety.mjs",
    "presentation:check": "node scripts/check-presentation-system.mjs",
    "recovery:check": "node scripts/check-save-recovery.mjs",
    "balance:check": "node scripts/check-game-balance.mjs",
    "childhood:sample": "node scripts/simulate-childhood.mjs --count 1 --seed demo",
    "childhood:batch": "node scripts/simulate-childhood.mjs --count 10000 --seed batch",
    "childhood:check": "node scripts/check-childhood-simulator.mjs",
    "childhood:play:check": "node scripts/check-childhood-play.mjs",
    "age6:p2:check": "node scripts/check-quarterly-age6-p2.mjs",
    "age6:blind:init": "node scripts/create-age6-blind-test-batch.mjs",
    "age6:blind:readiness": "node scripts/check-age6-blind-test-readiness.mjs",
    "age6:blind:serve": "node scripts/serve-age6-blind-test.mjs",
    "age6:blind:session:start": "node scripts/start-age6-blind-session.mjs",
    "age6:blind:browser:check": "node scripts/check-age6-blind-test-launcher-browser.mjs",
    "age6:blind:capture-checks": "node scripts/capture-age6-blind-test-checks.mjs",
    "age6:blind:check": "node scripts/check-age6-blind-test.mjs",
    "primary:sample": "node scripts/simulate-primary-education.mjs --count 1 --seed demo",
    "primary:batch": "node scripts/simulate-primary-education.mjs --count 10000 --seed batch",
    "primary:check": "node scripts/check-primary-education-simulator.mjs",
    "adolescence:sample": "node scripts/simulate-adolescence.mjs --count 1 --seed demo",
    "adolescence:batch": "node scripts/simulate-adolescence.mjs --count 10000 --seed batch",
    "adolescence:check": "node scripts/check-adolescence-simulator.mjs",
    "youth:sample": "node scripts/simulate-youth-entry.mjs --count 1 --seed demo",
    "youth:batch": "node scripts/simulate-youth-entry.mjs --count 10000 --seed batch",
    "youth:check": "node scripts/check-youth-entry-simulator.mjs",
    "life:sample": "node scripts/simulate-full-life.mjs --count 1 --seed demo",
    "life:batch": "node scripts/simulate-full-life.mjs --count 1000 --seed batch",
    "adult:check": "node scripts/check-adult-life-simulator.mjs",
    "annual:check": "node scripts/check-annual-operations.mjs",
    "social:check": "node scripts/check-social-characters.mjs",
    "timeline:check": "node scripts/check-timeline.mjs",
    "causality:check": "node scripts/check-long-term-causality.mjs",
    "mainline:check": "node scripts/check-life-mainline.mjs",
    "youth-mainline:check": "node scripts/check-youth-mainline-payoffs.mjs",
    "engine:check": "node scripts/check-game-engine.mjs",
    "gateway:check": "node scripts/check-game-gateway.mjs",
    "debug:check": "node scripts/check-debug-tools.mjs",
    "ui:check": "node scripts/check-ui-contract.mjs",
    "browser:check": "node scripts/check-browser-ui.mjs",
    "light-scene:spike:check": "node scripts/check-light-scene-spikes.mjs",
    "light-scene:spike:browser:check": "node scripts/check-light-scene-spikes-browser.mjs",
    "light-scene:contract:check": "node scripts/check-light-scene-contract.mjs",
    "light-scene:yard:check": "node scripts/check-light-scene-yard-content.mjs",
    "light-scene:core:check": "node scripts/check-light-scene-core-bridge.mjs",
    "light-scene:g1:check": "npm run light-scene:contract:check && npm run light-scene:yard:check && npm run light-scene:core:check",
    "light-scene:g1:browser:check": "node scripts/check-light-scene-g1-browser.mjs",
    "h5:build": "node scripts/build-h5-release.mjs",
    "h5:check": "node scripts/check-h5-release.mjs",
    "h5:browser:check": "node scripts/check-h5-browser.mjs",
    "release:check": "npm run check && npm run browser:check && npm run h5:build && npm run h5:check && npm run h5:browser:check",
    "game:play": "vite --config apps/game/vite.config.ts",
    "game:build": "vite build --config apps/game/vite.config.ts",
    "game:preview": "vite preview --config apps/game/vite.config.ts",
    "game:typecheck": "tsc -p apps/game/tsconfig.json",
    "esports:check": "node --experimental-strip-types scripts/check-esports-career-system.mjs && node --experimental-strip-types scripts/check-lol-esports-ecosystem.mjs && node --experimental-strip-types scripts/check-avatar-and-lol-career.mjs",
    "esports:lol:check": "node --experimental-strip-types scripts/check-lol-esports-ecosystem.mjs && node --experimental-strip-types scripts/check-avatar-and-lol-career.mjs",
    "education:check": "node --experimental-strip-types scripts/check-gaokao-education-system.mjs && node --experimental-strip-types scripts/check-gaokao-modal.mjs",
    "education:modal:check": "node --experimental-strip-types scripts/check-gaokao-modal.mjs",
    "game:foundation:check": "node scripts/check-game-runtime-foundation.mjs",
    "game:browser:check": "node scripts/check-game-runtime-browser.mjs",
    "game:startup:browser:check": "node scripts/check-game-startup-browser.mjs",
    "game:birth:browser:check": "node scripts/check-game-birth-browser.mjs",
    "game:p1:browser:check": "node scripts/check-game-p1-browser.mjs",
    "game:p2:browser:check": "node scripts/check-game-p2-browser.mjs",
    "game:check": "npm run game:typecheck && npm run game:foundation:check && npm run game:build && npm run game:startup:browser:check && npm run game:birth:browser:check && npm run game:browser:check && npm run game:p1:browser:check && npm run game:p2:browser:check",
    "play": "node scripts/serve-game.mjs",
    "check": "npm run birth:check && npm run foundation:check && npm run process:check && npm run map:check && npm run events:check && npm run variety:check && npm run presentation:check && npm run recovery:check && npm run balance:check && npm run childhood:check && npm run childhood:play:check && npm run age6:p2:check && npm run primary:check && npm run adolescence:check && npm run youth:check && npm run adult:check && npm run annual:check && npm run social:check && npm run timeline:check && npm run causality:check && npm run mainline:check && npm run youth-mainline:check && npm run engine:check && npm run gateway:check && npm run debug:check && npm run ui:check"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "phaser": "^3.90.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
